# Trade Journal — Environment Configuration Template
# Copy this file to .env for local development.
# In production, set these variables in your hosting dashboard (e.g. Vercel, Netlify).
# NEVER commit the real .env file or your Supabase service_role key to Git.

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Publishable Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Restrict access to a single specific Supabase user ID.
# Leave blank to allow any authenticated account in your Supabase project.
# VITE_AUTHORIZED_USER_ID=00000000-0000-0000-0000-000000000000
